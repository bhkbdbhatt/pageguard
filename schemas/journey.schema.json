{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pageguard.dev/schemas/journey.schema.json",
  "title": "Pageguard Journey",
  "description": "A scripted, multi-step user flow executed by the journey tester. A journey runs sequentially in a single browser session; after each step the page state is captured and validated against the step's expectations. Journeys may be written in YAML or JSON; both are validated against this schema.",
  "type": "object",
  "required": ["version", "name", "steps"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Journey language version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable journey name."
    },
    "description": { "type": "string" },
    "base_url": {
      "type": "string",
      "description": "Base URL used to resolve relative navigate targets."
    },
    "defaults": { "$ref": "#/$defs/defaults" },
    "session": { "$ref": "#/$defs/session" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "wait_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_agent": { "type": "string" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "locale": { "type": "string" },
        "timezone": { "type": "string" },
        "ignore_https_errors": { "type": "boolean" },
        "capture_data_layer": { "type": "boolean" }
      }
    },
    "action": {
      "type": "string",
      "enum": ["navigate", "click", "fill", "type", "wait"]
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url_contains": { "type": "string" },
        "title_contains": { "type": "string" },
        "status": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "absent_tags": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } },
        "cookies": { "type": "array", "items": { "type": "string" } },
        "absent_cookies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": { "$ref": "#/$defs/action" },
        "description": { "type": "string" },
        "selector": { "type": "string" },
        "value": {
          "type": "string",
          "description": "Target URL for navigate, or the input value for fill/type."
        },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "wait_ms": { "type": "integer", "minimum": 0 },
        "expect": { "$ref": "#/$defs/expect" }
      }
    }
  }
}
